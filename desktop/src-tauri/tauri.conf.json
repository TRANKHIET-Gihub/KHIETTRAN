{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KHIETTRAN AI STUDIO",
  "version": "0.1.0",
  "identifier": "vn.khiettran.aistudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KHIETTRAN AI STUDIO",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000 https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "AI portrait photo editor",
    "category": "GraphicsAndDesign"
  }
}