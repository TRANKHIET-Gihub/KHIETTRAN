APP_ENV=development
APP_NAME=KHIETTRAN AI STUDIO API
API_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
MAX_UPLOAD_MB=5

# Server-side only. Never put the token in desktop/.env or frontend source.
AI_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=recraft-ai
REPLICATE_MODEL_NAME=recraft-remove-background
REPLICATE_IMAGE_INPUT_FIELD=image
REPLICATE_FACE_MODEL_OWNER=tencentarc
REPLICATE_FACE_MODEL_NAME=gfpgan
